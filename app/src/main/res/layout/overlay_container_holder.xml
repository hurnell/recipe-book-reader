<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:padding="0dp"
    android:visibility="gone">

    <ScrollView
        android:id="@+id/bookInfoOverlay"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:background="@drawable/overlay_background"
        android:clipToPadding="false"
        android:padding="0dp"
        android:scrollbars="none"
        android:visibility="gone"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <apk.hurnell.recipebookreader.ui.EditableTextView
                android:id="@+id/bookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:bold="true"
                app:textSize="18sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <FrameLayout
                    android:id="@+id/bookPreviewWrapper"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/book_shadow_light"
                    android:padding="8dp"
                    app:layout_constraintDimensionRatio="2:3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/bookPreviewImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/pdf_preview"
                        android:padding="1dp"
                        android:scaleType="fitXY"
                        android:visibility="visible" />
                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/coverOptionsRecycler"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <ImageButton
                    android:id="@+id/btnPickCover"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_online"
                    android:src="@drawable/ic_search"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/pastel_blue" />

                <ImageButton
                    android:id="@+id/btnRevertCover"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_online"
                    android:src="@drawable/ic_refresh"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="gone"
                    app:tint="@color/pastel_blue" />

                <LinearLayout
                    android:id="@+id/buttonContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/btnSearchCovers"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="0dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/search_online"
                        android:src="@drawable/ic_online"
                        app:tint="@color/pastel_blue" />

                    <ImageButton
                        android:id="@+id/btnCloseGallery"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="0dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close_gallery"
                        android:src="@drawable/ic_close"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <apk.hurnell.recipebookreader.ui.EditableTextView
                android:id="@+id/isbnNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                app:bold="false"
                app:textSize="16sp" />

            <apk.hurnell.recipebookreader.ui.EditableTextView
                android:id="@+id/bookAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:bold="false"
                app:textSize="16sp" />

            <apk.hurnell.recipebookreader.ui.EditableCategoryView
                android:id="@+id/bookCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:bold="false"
                app:textSize="16sp" />

            <apk.hurnell.recipebookreader.ui.EditableCategoryView
                android:id="@+id/bookSubCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:bold="false"
                app:textSize="16sp" />


            <TextView
                android:id="@+id/volumeTitleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingTop="6dp"
                android:text="@string/show_title_on_volume_press"
                android:textColor="@color/nav_text"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/volumeTitleWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="@string/show_table_of_contents_title_on_volume_click"
                    android:textSize="14sp"
                    tools:ignore="NestedWeights" />
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/volumeTitleCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="0dp"
                    android:background="@color/white"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:buttonTint="@color/pastel_blue"
                    android:padding="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/deleteLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingTop="6dp"
                android:text="@string/delete"
                android:textColor="@color/nav_text"
                android:textSize="12sp"
                android:textStyle="italic"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/deleteWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/delete_book"
                    android:textSize="16sp"
                    tools:ignore="NestedWeights" />

                <ImageButton
                    android:id="@+id/btnDeleteBook"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_online"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/pastel_blue" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>