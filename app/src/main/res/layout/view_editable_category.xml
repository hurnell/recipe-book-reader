<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Optional Label above the editable row -->
    <TextView
        android:id="@+id/editableCategoryViewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingBottom="4dp"
        android:text="@string/label_for_editable_widget"
        android:textColor="@color/grey"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="visible" />

    <!-- Row with stacked TextView / dropdown + buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- FrameLayout to overlay TextView and Dropdown -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/editableCategoryViewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/unknown_value"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/categoryChooserWrapper"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/categoryChooser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/choose_or_type_new_category" />

            </com.google.android.material.textfield.TextInputLayout>

        </FrameLayout>

        <!-- Buttons stay at the end of the row -->
        <ImageButton
            android:id="@+id/categoryEditButton"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/generic_editable_text_view_edit_button"
            android:padding="2dp"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/categoryCancelButton"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/generic_editable_text_view_cancel_button"
            android:padding="2dp"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>