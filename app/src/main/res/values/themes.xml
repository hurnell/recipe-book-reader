<resources>
    <style name="Theme.RecipeBookReader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pastel_blue</item>
        <item name="colorPrimaryContainer">@color/pastel_blue</item>
        <item name="colorSecondary">@color/pastel_blue</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/pastel_blue</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorSecondary">@color/dark_text</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:spinnerItemStyle">@style/mySpinnerItemSelectedStyle</item>

    </style>
    <style name="mySpinnerItemSelectedStyle" parent="@android:style/Widget.Holo.TextView.SpinnerItem">
        <item name="android:textColor">@color/nav_text</item>
    </style>

    <style name="FileBrowserToolbarTheme" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="colorControlNormal">@color/nav_text</item>
        <item name="actionMenuTextColor">@color/nav_text</item>
        <item name="displayOptions">showCustom|useLogo|showHome</item>
    </style>
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="backgroundTint">@color/white</item>

        <!-- Optional but good to override -->
        <item name="colorSurface">@color/white</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button.TextButton.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/App.Dialog.Title.Text</item>
    </style>

    <style name="Widget.App.Button.TextButton.Dialog" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/nav_text</item>
        <item name="rippleColor">@color/nav_text</item>
        <item name="strokeColor">@color/pastel_blue</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <style name="App.Dialog.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textAlignment">center</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">match_parent</item>
    </style>
</resources>
